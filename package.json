{
  "name": "data-dictionary-cli",
  "version": "1.0.0",
  "description": "A command-line tool for generating data dictionaries from SQLite or PostgreSQL databases",
  "bin": {
    "datadict": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "data-dictionary",
    "database",
    "sqlite",
    "postgresql",
    "documentation",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.6",
    "ejs": "^3.1.9",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "marked": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/sqlite3": "^3.1.11",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^29.5.10",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "prettier": "^3.1.0"
  }
}
